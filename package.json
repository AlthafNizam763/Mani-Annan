{
  "name": "project-echo-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=@project-echo/api",
    "start:api": "npm start --workspace=@project-echo/api",
    "emulators": "firebase emulators:start --only auth,firestore"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
