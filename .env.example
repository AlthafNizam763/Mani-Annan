# Mani-Annan — Environment Variables Configuration Template
# NOTE: DO NOT commit real secrets (.env) to version control.

# ==============================================================================
# 1. BACKEND API SERVICE (Set these in Render Dashboard -> Environment Variables)
# ==============================================================================
PORT=8001
NODE_ENV=production

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=mani-annan

# Production Option A (Recommended): Paste full JSON service account key
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"mani-annan",...}

# Production Option B: Discrete credentials from Firebase Console
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@mani-annan.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Local Development Only (Uncomment to use Firebase Emulator Suite)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# CORS Allowed Origins (Comma-separated list, e.g., your Vercel domain and local test ports)
CORS_ORIGIN=https://mani-annan.vercel.app,http://localhost:3000

# LLM Provider Configuration (CRITICAL: Keep on backend only! Never put in NEXT_PUBLIC_)
# Supported providers: "gemini" | "mock"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash


# ==============================================================================
# 2. FRONTEND WEB APP (Set these in Vercel Dashboard -> Environment Variables)
# ==============================================================================
# Backend API Base URL (Supports either with or without /api/v1; trailing slash is auto-handled)
NEXT_PUBLIC_API_URL=https://mani-annan.onrender.com/api/v1

# Firebase Client Web SDK Config (Safe for browser client)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyC6przI8Nb2Zp6fDhiuJ4SgC-vjjnWgjpg
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mani-annan.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mani-annan
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mani-annan.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1065638790508
NEXT_PUBLIC_FIREBASE_APP_ID=1:1065638790508:web:ef7ed5cbb89a879011df49
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-272QZVEXP3

# Set to "true" only when developing with local Firebase emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
