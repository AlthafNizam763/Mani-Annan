# Project Echo — Environment Variables Configuration

# -----------------
# API Service
# -----------------
PORT=4001
NODE_ENV=development

# Firebase Admin Configuration
# Option 1: Using Firebase Local Emulators (Recommended for development/testing)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=project-echo-dev

# Option 2: Live Firebase credentials (for production/staging)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# LLM Provider Configuration
# Supported providers: "gemini" | "mock"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# -----------------
# Web Frontend
# -----------------
NEXT_PUBLIC_FIREBASE_API_KEY=mock-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=project-echo-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=project-echo-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=project-echo-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
